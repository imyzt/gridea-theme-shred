{
  "name": "shred",
  "version": "1.2.0",
  "author": "imyzt",
  "description": "Gridea Pro 文字博客主题：阅读流为本，纸质碎边点缀。独立插件，不改其他主题源码。",
  "engine": "jinja2",
  "templateEngine": "jinja2",
  "repository": "https://github.com/imyzt/gridea-theme-shred",
  "customConfig": [
    {
      "name": "siteLogo",
      "label": "站点 Logo",
      "group": "基础设置",
      "type": "picture-upload",
      "value": "",
      "note": "推荐尺寸 40x40"
    },
    {
      "name": "enableShredMotion",
      "label": "列表入场动效",
      "group": "外观设置",
      "type": "toggle",
      "value": true
    },
    {
      "name": "defaultTheme",
      "label": "默认主题",
      "group": "外观设置",
      "type": "select",
      "value": "light",
      "options": [
        { "label": "浅色", "value": "light" },
        { "label": "深色", "value": "dark" }
      ]
    },
    {
      "name": "accentColor",
      "label": "强调色",
      "group": "外观设置",
      "type": "input",
      "value": "#0f6e56",
      "note": "默认墨绿，适合文字博客"
    },
    {
      "name": "heatmapColor",
      "label": "热力图主色",
      "group": "外观设置",
      "type": "input",
      "value": "#0f6e56"
    },
    {
      "name": "showSearch",
      "label": "显示搜索",
      "group": "功能开关",
      "type": "toggle",
      "value": true
    },
    {
      "name": "showSidebar",
      "label": "显示侧边栏（内页）",
      "group": "功能开关",
      "type": "toggle",
      "value": false
    },
    {
      "name": "sidebarDescription",
      "label": "侧栏简介",
      "group": "侧边栏设置",
      "type": "textarea",
      "value": ""
    },
    {
      "name": "showHeatmap",
      "label": "闪念热力图",
      "group": "功能开关",
      "type": "toggle",
      "value": true
    },
    {
      "name": "githubUrl",
      "label": "GitHub",
      "group": "社交链接",
      "type": "input",
      "value": "https://github.com/imyzt"
    },
    {
      "name": "twitterUrl",
      "label": "Twitter/X",
      "group": "社交链接",
      "type": "input",
      "value": ""
    },
    {
      "name": "weiboUrl",
      "label": "微博",
      "group": "社交链接",
      "type": "input",
      "value": ""
    },
    {
      "name": "customCss",
      "label": "自定义 CSS",
      "group": "高级设置",
      "type": "textarea",
      "value": ""
    },
    {
      "name": "customJs",
      "label": "自定义 JavaScript",
      "group": "高级设置",
      "type": "textarea",
      "value": ""
    },
    {
      "name": "footerInfo",
      "label": "页脚信息",
      "group": "基础设置",
      "type": "textarea",
      "value": "",
      "note": "支持 HTML"
    }
  ]
}
